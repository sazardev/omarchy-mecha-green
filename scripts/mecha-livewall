#!/usr/bin/env bash
# mecha-livewall — turn a still into a filtered, looping Halo-style live wallpaper.
#
# Examples:
#   mecha-livewall photo.jpg --style command --install
#   mecha-livewall halo.jpg --mode both --style rain --install --name chief-rain
#   mecha-livewall theme/backgrounds/13-radar.webp --no-filter --style radar
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-mecha-green"
ASSETS=""
if [[ -d "$ROOT/assets/live" ]]; then
  ASSETS="$ROOT/assets/live"
elif [[ -d "$DATA_DIR/assets/live" ]]; then
  ASSETS="$DATA_DIR/assets/live"
elif [[ -d "$SCRIPT_DIR/../assets/live" ]]; then
  ASSETS="$SCRIPT_DIR/../assets/live"
fi

THEMETIZE=""
if [[ -x "$SCRIPT_DIR/mecha-themetize" ]]; then
  THEMETIZE="$SCRIPT_DIR/mecha-themetize"
elif command -v mecha-themetize >/dev/null 2>&1; then
  THEMETIZE="$(command -v mecha-themetize)"
elif [[ -x "$ROOT/scripts/mecha-themetize" ]]; then
  THEMETIZE="$ROOT/scripts/mecha-themetize"
fi

INPUT=""
OUTPUT=""
MODE="dark"
STYLE="command"
DURATION=12
FPS=30
STRENGTH=80
NAME=""
INSTALL=0
SET_BG=0
FILTER=1
FORCE=0
FIT="2560x1440"

usage() {
  cat <<'EOF'
Usage: mecha-livewall <image> [output.mp4] [options]

Creates a seamless H.264 loop from a still, with a slow camera move, scanlines,
grain and a Halo-style military HUD overlay. The image is passed through the
Mecha Green palette filter unless --no-filter is used.

Options:
  --mode dark|light|both   Palette and theme target (default: dark)
  --style STYLE            command, rain, dust, pulse, storm, radar
                           (default: command)
  --duration SECONDS       Loop length (default: 12)
  --fps N                  Frame rate (default: 30)
  --strength 0-100         Theme filter strength (default: 80)
  --name NAME              Basename used by --install
  --install                Copy into ~/.config/omarchy/backgrounds/<theme>/
  --set                    Set the generated video as the current background
  --no-filter              Use the image as-is (already palette-graded)
  --force                  Overwrite the output file if it exists
  --fit WxH                Output size (default: 2560x1440)
  -h, --help               Show this help

Styles:
  command   slow push, scanlines, HUD frame and grain
  rain      command plus falling rain
  dust      slow pan with drifting fog and dust
  pulse     slow push with an amber energy glow
  storm     rain with a subtle lightning flicker
  radar     rotating radar sweep

Examples:
  mecha-livewall ~/Pictures/halo.jpg --style rain --install --set
  mecha-livewall art.png --mode both --style command --install --name my-wall
  mecha-livewall themes/mecha-green/backgrounds/8-mecha-helmet.webp \
    --no-filter --style command --name helmet
EOF
}

while (( $# > 0 )); do
  case "$1" in
    --mode) MODE="${2:-}"; shift 2 || { usage >&2; exit 2; } ;;
    --style) STYLE="${2:-}"; shift 2 || { usage >&2; exit 2; } ;;
    --duration) DURATION="${2:-}"; shift 2 || { usage >&2; exit 2; } ;;
    --fps) FPS="${2:-}"; shift 2 || { usage >&2; exit 2; } ;;
    --strength) STRENGTH="${2:-}"; shift 2 || { usage >&2; exit 2; } ;;
    --name) NAME="${2:-}"; shift 2 || { usage >&2; exit 2; } ;;
    --fit) FIT="${2:-}"; shift 2 || { usage >&2; exit 2; } ;;
    --install) INSTALL=1; shift ;;
    --set) SET_BG=1; shift ;;
    --no-filter) FILTER=0; shift ;;
    --filter) FILTER=1; shift ;;
    --force) FORCE=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --*) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
    *)
      if [[ -z $INPUT ]]; then INPUT="$1"
      elif [[ -z $OUTPUT ]]; then OUTPUT="$1"
      else echo "too many arguments: $1" >&2; exit 2
      fi
      shift ;;
  esac
done

[[ -n $INPUT ]] || { usage >&2; exit 2; }
[[ -f $INPUT ]] || { echo "input not found: $INPUT" >&2; exit 1; }
[[ $MODE =~ ^(dark|light|both)$ ]] || { echo "--mode must be dark, light or both" >&2; exit 2; }
[[ $STYLE =~ ^(command|rain|dust|pulse|storm|radar)$ ]] || { echo "unknown style: $STYLE" >&2; exit 2; }
[[ $DURATION =~ ^[0-9]+$ ]] && (( DURATION >= 4 && DURATION <= 60 )) || {
  echo "--duration must be 4-60 seconds" >&2; exit 2
}
[[ $FPS =~ ^[0-9]+$ ]] && (( FPS >= 12 && FPS <= 60 )) || {
  echo "--fps must be 12-60" >&2; exit 2
}
[[ $STRENGTH =~ ^[0-9]+$ ]] && (( STRENGTH >= 0 && STRENGTH <= 100 )) || {
  echo "--strength must be 0-100" >&2; exit 2
}
[[ $FIT =~ ^[0-9]+x[0-9]+$ ]] || { echo "--fit must be WxH" >&2; exit 2; }
command -v ffmpeg >/dev/null 2>&1 || { echo "ffmpeg is required" >&2; exit 1; }
[[ -n $ASSETS && -f "$ASSETS/hud-dark.png" ]] || {
  echo "live wallpaper assets not found (expected assets/live)" >&2; exit 1
}
(( FILTER == 0 )) || [[ -x $THEMETIZE ]] || {
  echo "mecha-themetize is required unless --no-filter is used" >&2; exit 1
}

slug="$(printf '%s' "${NAME:-$(basename "${INPUT%.*}")}" |
  tr '[:upper:]' '[:lower:]' | sed -E 's/^(mecha-green-)?//; s/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
[[ -n $slug ]] || slug="live-wallpaper"

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

THEMES_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/themes"
USER_BG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/backgrounds"

next_number() {
  local theme="$1" max=0 found
  found=$(find "$USER_BG_ROOT/$theme" "$THEMES_ROOT/$theme/backgrounds" -maxdepth 1 -type f -name '[0-9][0-9]-*' -printf '%f\n' 2>/dev/null |
    sed -E 's/^([0-9]{2})-.*/\1/' | sort -n | tail -1 || true)
  [[ -n $found ]] && max=$((10#$found))
  printf '%02d' $((max + 1))
}

install_video() {
  local theme="$1" source="$2" dest_dir num dest
  dest_dir="$USER_BG_ROOT/$theme"
  mkdir -p "$dest_dir"
  num=$(next_number "$theme")
  dest="$dest_dir/$num-live-$slug.mp4"
  if [[ -e $dest && $FORCE -eq 0 ]]; then
    echo "already exists: $dest (use --force)" >&2
    return 1
  fi
  cp -f "$source" "$dest"
  echo "$dest"
}

render_one() {
  local mode="$1" out="$2" src="$3"
  local frames=$((DURATION * FPS)) graph inputs idx last
  local hud="$ASSETS/hud-$mode.png"
  local scan="$ASSETS/scanlines-$mode.png"
  local rain="$ASSETS/rain-$mode.png"
  local fog="$ASSETS/fog-$mode.webp"
  local glow="$ASSETS/glow-$mode.png"
  local sweep="$ASSETS/sweep-$mode.png"

  inputs=(-loop 1 -framerate "$FPS" -i "$src")
  graph="[0:v]scale=3200:1800:force_original_aspect_ratio=increase,crop=3200:1800,"
  graph+="zoompan=z='1.03+0.018*sin(2*PI*on/$frames)':"
  graph+="x='iw/2-(iw/zoom/2)+sin(2*PI*on/$frames)*40':"
  graph+="y='ih/2-(ih/zoom/2)+cos(2*PI*on/$frames)*24':"
  graph+="d=$frames:s=$FIT:fps=$FPS,format=rgba[base];"
  idx=1
  last="base"

  # The radar artwork already has its own HUD frame.
  if [[ $STYLE != radar ]]; then
    inputs+=(-loop 1 -framerate "$FPS" -i "$hud")
    graph+="[$idx:v]format=rgba[hud];[$last][hud]overlay=0:0:format=auto[o$idx];"
    last="o$idx"; idx=$((idx + 1))
  fi

  case "$STYLE" in
    rain|storm)
      inputs+=(-loop 1 -framerate "$FPS" -i "$scan")
      graph+="[$idx:v]format=rgba[scan];[$last][scan]overlay=0:0:format=auto[o$idx];"
      last="o$idx"; idx=$((idx + 1))
      inputs+=(-loop 1 -framerate "$FPS" -i "$rain")
      graph+="[$idx:v]scroll=vertical=0.002777,format=rgba,colorchannelmixer=aa=0.60[rain];"
      graph+="[$last][rain]overlay=0:0:format=auto[o$idx];"
      last="o$idx"; idx=$((idx + 1))
      ;;
    dust)
      inputs+=(-loop 1 -framerate "$FPS" -i "$fog")
      graph+="[$idx:v]format=rgba,scale=3000:1800,colorchannelmixer=aa=0.26[fog];"
      graph+="[$last][fog]overlay=x='-220+120*sin(2*PI*t/$DURATION)':"
      graph+="y='-100+40*cos(2*PI*t/$DURATION)':format=auto[o$idx];"
      last="o$idx"; idx=$((idx + 1))
      ;;
    pulse)
      inputs+=(-loop 1 -framerate "$FPS" -i "$scan")
      graph+="[$idx:v]format=rgba[scan];[$last][scan]overlay=0:0:format=auto[o$idx];"
      last="o$idx"; idx=$((idx + 1))
      inputs+=(-loop 1 -framerate "$FPS" -i "$glow")
      graph+="[$idx:v]format=rgba,colorchannelmixer=aa=0.30[glow];"
      graph+="[$last][glow]overlay=x='(W-w)/2':y='(H-h)/2':format=auto[o$idx];"
      last="o$idx"; idx=$((idx + 1))
      ;;
    radar)
      inputs+=(-loop 1 -framerate "$FPS" -i "$scan")
      graph+="[$idx:v]format=rgba[scan];[$last][scan]overlay=0:0:format=auto[o$idx];"
      last="o$idx"; idx=$((idx + 1))
      inputs+=(-loop 1 -framerate "$FPS" -i "$sweep")
      graph+="[$idx:v]rotate=a='2*PI*t/$DURATION':c=none:ow=rotw(iw):oh=roth(ih),format=rgba[sweep];"
      graph+="[$last][sweep]overlay=x='(W-w)/2':y='(H-h)/2':format=auto[o$idx];"
      last="o$idx"; idx=$((idx + 1))
      ;;
    command) ;;
  esac

  if [[ $STYLE == storm ]]; then
    graph+="[$last]noise=alls=4:allf=t+u,eq=brightness='0.010*sin(12*PI*t)':saturation=1.05,format=yuv420p[v]"
  elif [[ $STYLE == pulse ]]; then
    graph+="[$last]noise=alls=3:allf=t+u,eq=brightness='0.005*sin(2*PI*t/3)':saturation=1.02,format=yuv420p[v]"
  else
    graph+="[$last]noise=alls=3:allf=t+u,eq=brightness='0.003*sin(2*PI*t/3)':saturation=1.02,format=yuv420p[v]"
  fi

  ffmpeg -hide_banner -loglevel error -y "${inputs[@]}" \
    -filter_complex "$graph" -map "[v]" -frames:v "$frames" -an \
    -c:v libx264 -preset medium -crf 22 -pix_fmt yuv420p \
    -profile:v high -level 4.2 -movflags +faststart "$out"
}

run_mode() {
  local mode="$1" src="$INPUT" out=""
  if (( FILTER )); then
    "$THEMETIZE" "$INPUT" "$TMP/filtered-$mode.png" --mode "$mode" \
      --strength "$STRENGTH" --fit none >/dev/null
    src="$TMP/filtered-$mode.png"
  fi

  if [[ -n $OUTPUT ]]; then
    if [[ $MODE == both ]]; then
      local base="${OUTPUT%.*}"
      out="${base}-${mode}.${OUTPUT##*.}"
    else
      out="$OUTPUT"
    fi
  elif (( INSTALL )); then
    out="$TMP/render-$mode.mp4"
  else
    out="${INPUT%.*}-live-${mode}.mp4"
  fi

  if [[ -e $out && $FORCE -eq 0 ]]; then
    echo "already exists: $out (use --force)" >&2
    return 1
  fi
  echo "Rendering $mode / $STYLE / ${DURATION}s ..."
  render_one "$mode" "$out" "$src"
  echo "wrote $out"
  LAST_OUTPUT="$out"
  LAST_MODE="$mode"
  if [[ $mode == dark ]]; then DARK_OUT="$out"; else LIGHT_OUT="$out"; fi
}

LAST_OUTPUT=""
LAST_MODE=""
DARK_OUT=""
LIGHT_OUT=""
if [[ $MODE == dark || $MODE == both ]]; then
  run_mode dark
fi
if [[ $MODE == light || $MODE == both ]]; then
  run_mode light
fi

if (( INSTALL )); then
  [[ -n $LAST_OUTPUT ]] || exit 1
  theme="mecha-green"
  # If both modes were rendered, install the dark output in dark and light in light.
  if [[ $MODE == both ]]; then
    for mode in dark light; do
      if [[ $mode == dark ]]; then src="$DARK_OUT"; else src="$LIGHT_OUT"; fi
      [[ -f $src ]] || continue
      [[ $mode == light ]] && theme="mecha-green-light" || theme="mecha-green"
      dest=$(install_video "$theme" "$src") && echo "installed $dest"
      if (( SET_BG )); then
        current=$(omarchy theme current 2>/dev/null || true)
        if [[ $mode == light && $current == *Light* ]] || [[ $mode == dark && $current != *Light* ]]; then
          omarchy theme bg set "$dest" >/dev/null 2>&1 || true
        fi
      fi
    done
  else
    [[ $LAST_MODE == light ]] && theme="mecha-green-light"
    dest=$(install_video "$theme" "$LAST_OUTPUT") && echo "installed $dest"
    if (( SET_BG )); then
      current=$(omarchy theme current 2>/dev/null || true)
      if [[ $LAST_MODE == light && $current == *Light* ]] || [[ $LAST_MODE == dark && $current != *Light* ]]; then
        omarchy theme bg set "$dest" >/dev/null 2>&1 || true
      fi
    fi
  fi
  command -v omarchy >/dev/null 2>&1 && omarchy theme bg cache >/dev/null 2>&1 || true
fi

if (( SET_BG )) && (( ! INSTALL )); then
  chosen="$LAST_OUTPUT"
  if [[ $MODE == both ]]; then
    current=$(omarchy theme current 2>/dev/null || true)
    if [[ $current == *Light* ]]; then chosen="$LIGHT_OUT"; else chosen="$DARK_OUT"; fi
  fi
  omarchy theme bg set "$chosen" >/dev/null 2>&1 || true
fi
